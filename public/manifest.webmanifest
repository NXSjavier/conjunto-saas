{
  "name": "Conjuntos App",
  "short_name": "Conjuntos",
  "description": "Sistema residencial con gestión de conjunto, reservas, visitas, anuncios y reportes.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#020817",
  "theme_color": "#0f172a",
  "lang": "es",
  "dir": "ltr",
  "categories": ["productivity", "lifestyle", "business"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "protocol_handlers": [
    {
      "protocol": "web+conjuntos",
      "url": "/?q=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Anuncios",
      "short_name": "Anuncios",
      "description": "Ver anuncios del conjunto",
      "url": "/?view=announcements",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Reservas",
      "short_name": "Reservas",
      "description": "Gestionar reservas",
      "url": "/?view=bookings",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
